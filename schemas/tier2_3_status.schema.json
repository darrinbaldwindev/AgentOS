{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentos.dev/schemas/tier2_3_status.schema.json",
  "title": "AgentOS Tier 2.3 Status",
  "description": "Canonical machine-readable contract for five governance gates, seven evidence suites, blocked states, and GREEN eligibility.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "mission_id", "project", "tier", "overall_status", "green_eligible", "current_commit", "gates", "tests", "blocking_reasons", "evidence", "generated_at", "generated_by"],
  "properties": {
    "schema": { "const": "agentos.tier2_3.status" },
    "schema_version": { "const": "1.1" },
    "mission_id": { "type": "string", "minLength": 1 },
    "project": { "type": "string", "minLength": 1 },
    "tier": { "const": "2.3" },
    "overall_status": { "$ref": "#/$defs/status" },
    "green_eligible": { "type": "boolean" },
    "current_commit": { "$ref": "#/$defs/shaOrNull" },
    "last_verified_commit": { "$ref": "#/$defs/shaOrNull" },
    "gates": {
      "type": "object", "additionalProperties": false,
      "required": ["G1", "G2", "G3", "G4", "G5"],
      "properties": {
        "G1": { "$ref": "#/$defs/gateG1" },
        "G2": { "$ref": "#/$defs/gateG2" },
        "G3": { "$ref": "#/$defs/gateG3" },
        "G4": { "$ref": "#/$defs/gateG4" },
        "G5": { "$ref": "#/$defs/gateG5" }
      }
    },
    "tests": {
      "type": "object", "additionalProperties": false,
      "required": ["T1", "T2", "T3", "T4", "T5", "T6", "T7"],
      "properties": {
        "T1": { "$ref": "#/$defs/testT1" },
        "T2": { "$ref": "#/$defs/testT2" },
        "T3": { "$ref": "#/$defs/testT3" },
        "T4": { "$ref": "#/$defs/testT4" },
        "T5": { "$ref": "#/$defs/testT5" },
        "T6": { "$ref": "#/$defs/testT6" },
        "T7": { "$ref": "#/$defs/testT7" }
      }
    },
    "blocking_reasons": { "type": "array", "items": { "$ref": "#/$defs/blockingReason" } },
    "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
    "generated_at": { "type": "string", "format": "date-time" },
    "generated_by": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "status": { "type": "string", "enum": ["PENDING", "RUNNING", "PASS", "FAIL", "BLOCKED", "SKIPPED", "VERIFIED", "REJECTED"] },
    "shaOrNull": { "type": ["string", "null"], "pattern": "^[0-9a-fA-F]{40}$" },
    "gateBase": {
      "type": "object", "additionalProperties": false,
      "required": ["gate_id", "name", "status", "required_evidence", "evidence", "blocking_reasons", "last_evaluated_commit", "verified_by", "updated_at"],
      "properties": {
        "gate_id": { "type": "string", "pattern": "^G[1-5]$" },
        "name": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/status" },
        "required_evidence": { "type": "array", "items": { "type": "string", "pattern": "^T[1-7]$" }, "minItems": 1 },
        "evidence": { "type": "array", "items": { "type": "string" } },
        "blocking_reasons": { "type": "array", "items": { "type": "string" } },
        "last_evaluated_commit": { "$ref": "#/$defs/shaOrNull" },
        "verified_by": { "type": "array", "items": { "type": "string" } },
        "updated_at": { "type": ["string", "null"], "format": "date-time" }
      },
      "allOf": [
        { "if": { "properties": { "status": { "const": "BLOCKED" } } }, "then": { "properties": { "blocking_reasons": { "minItems": 1 } } } },
        { "if": { "properties": { "status": { "const": "PASS" } } }, "then": { "properties": { "blocking_reasons": { "maxItems": 0 } } } }
      ]
    },
    "gateG1": { "allOf": [{ "$ref": "#/$defs/gateBase" }, { "properties": { "gate_id": { "const": "G1" }, "name": { "const": "Scope & Authority" }, "required_evidence": { "const": ["T1"] } } }] },
    "gateG2": { "allOf": [{ "$ref": "#/$defs/gateBase" }, { "properties": { "gate_id": { "const": "G2" }, "name": { "const": "Budget & Resource Control" }, "required_evidence": { "const": ["T2"] } } }] },
    "gateG3": { "allOf": [{ "$ref": "#/$defs/gateBase" }, { "properties": { "gate_id": { "const": "G3" }, "name": { "const": "Execution Safety" }, "required_evidence": { "const": ["T3"] } } }] },
    "gateG4": { "allOf": [{ "$ref": "#/$defs/gateBase" }, { "properties": { "gate_id": { "const": "G4" }, "name": { "const": "Worker Capability & Consent" }, "required_evidence": { "const": ["T4"] } } }] },
    "gateG5": { "allOf": [{ "$ref": "#/$defs/gateBase" }, { "properties": { "gate_id": { "const": "G5" }, "name": { "const": "Verification, Recovery & Integrity" }, "required_evidence": { "const": ["T5", "T6", "T7"] } } }] },
    "testBase": {
      "type": "object", "additionalProperties": false,
      "required": ["test_id", "name", "parent_gate", "status", "executed", "passed", "evidence", "failures", "blocking_reasons", "commit", "test_command", "executed_at"],
      "properties": {
        "test_id": { "type": "string", "pattern": "^T[1-7]$" },
        "name": { "type": "string", "minLength": 1 },
        "parent_gate": { "type": "string", "pattern": "^G[1-5]$" },
        "status": { "$ref": "#/$defs/status" },
        "executed": { "type": "boolean" },
        "passed": { "type": "boolean" },
        "evidence": { "type": "array", "items": { "type": "string" } },
        "failures": { "type": "array", "items": { "type": "string" } },
        "blocking_reasons": { "type": "array", "items": { "type": "string" } },
        "commit": { "$ref": "#/$defs/shaOrNull" },
        "test_command": { "type": ["string", "null"] },
        "executed_at": { "type": ["string", "null"], "format": "date-time" }
      },
      "allOf": [
        { "if": { "properties": { "status": { "const": "PASS" } } }, "then": { "required": ["executed", "passed"], "properties": { "executed": { "const": true }, "passed": { "const": true }, "failures": { "maxItems": 0 }, "blocking_reasons": { "maxItems": 0 } } } },
        { "if": { "properties": { "status": { "const": "FAIL" } } }, "then": { "required": ["executed"], "properties": { "executed": { "const": true }, "passed": { "const": false } } } },
        { "if": { "properties": { "status": { "const": "BLOCKED" } } }, "then": { "properties": { "blocking_reasons": { "minItems": 1 }, "passed": { "const": false } } } },
        { "if": { "properties": { "status": { "const": "SKIPPED" } } }, "then": { "properties": { "passed": { "const": false } } } }
      ]
    },
    "testT1": { "allOf": [{ "$ref": "#/$defs/testBase" }, { "properties": { "test_id": { "const": "T1" }, "parent_gate": { "const": "G1" } } }] },
    "testT2": { "allOf": [{ "$ref": "#/$defs/testBase" }, { "properties": { "test_id": { "const": "T2" }, "parent_gate": { "const": "G2" } } }] },
    "testT3": { "allOf": [{ "$ref": "#/$defs/testBase" }, { "properties": { "test_id": { "const": "T3" }, "parent_gate": { "const": "G3" } } }] },
    "testT4": { "allOf": [{ "$ref": "#/$defs/testBase" }, { "properties": { "test_id": { "const": "T4" }, "parent_gate": { "const": "G4" } } }] },
    "testT5": { "allOf": [{ "$ref": "#/$defs/testBase" }, { "properties": { "test_id": { "const": "T5" }, "parent_gate": { "const": "G5" } } }] },
    "testT6": { "allOf": [{ "$ref": "#/$defs/testBase" }, { "properties": { "test_id": { "const": "T6" }, "parent_gate": { "const": "G5" } } }] },
    "testT7": { "allOf": [{ "$ref": "#/$defs/testBase" }, { "properties": { "test_id": { "const": "T7" }, "parent_gate": { "const": "G5" } } }] },
    "blockingReason": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "message", "severity", "blocks", "resolution_required"],
      "properties": {
        "code": { "type": "string", "enum": ["MISSING_EVIDENCE", "MISSING_AUTHORITY", "INVALID_SCOPE", "CAPABILITY_MISMATCH", "CONSENT_REQUIRED", "BUDGET_UNAVAILABLE", "BUDGET_RESERVATION_FAILED", "PATH_AUTHORITY_UNAVAILABLE", "WORKER_UNTRUSTED", "VERIFICATION_UNAVAILABLE", "AUDIT_UNAVAILABLE", "DEPENDENCY_UNAVAILABLE", "STALE_EVIDENCE", "TEST_NOT_EXECUTED", "PRODUCTION_AUTHORIZATION_REQUIRED", "UNKNOWN_STATE"] },
        "message": { "type": "string", "minLength": 1 },
        "severity": { "type": "string", "enum": ["INFO", "WARNING", "HIGH", "CRITICAL"] },
        "blocks": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "resolution_required": { "type": "string", "minLength": 1 }
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_id", "type", "source", "result"],
      "properties": {
        "evidence_id": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "enum": ["SOURCE_INSPECTION", "UNIT_TEST", "INTEGRATION_TEST", "END_TO_END_TEST", "RUNTIME", "AUDIT_LOG", "PRS_EVALUATION", "GREEN_AGENT_REVIEW", "PRODUCTION"] },
        "source": { "type": "string", "minLength": 1 },
        "commit": { "$ref": "#/$defs/shaOrNull" },
        "test_id": { "type": ["string", "null"], "pattern": "^T[1-7]$" },
        "result": { "$ref": "#/$defs/status" },
        "artifact": { "type": ["string", "null"] },
        "executed_at": { "type": ["string", "null"], "format": "date-time" },
        "verified_by": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "green_eligible": { "const": true } } },
      "then": {
        "properties": {
          "overall_status": { "enum": ["PASS", "VERIFIED"] },
          "gates": {
            "properties": {
              "G1": { "properties": { "status": { "enum": ["PASS", "VERIFIED"] } } },
              "G2": { "properties": { "status": { "enum": ["PASS", "VERIFIED"] } } },
              "G3": { "properties": { "status": { "enum": ["PASS", "VERIFIED"] } } },
              "G4": { "properties": { "status": { "enum": ["PASS", "VERIFIED"] } } },
              "G5": { "properties": { "status": { "enum": ["PASS", "VERIFIED"] } } }
            }
          },
          "tests": {
            "properties": {
              "T1": { "properties": { "status": { "enum": ["PASS", "VERIFIED"] } } },
              "T2": { "properties": { "status": { "enum": ["PASS", "VERIFIED"] } } },
              "T3": { "properties": { "status": { "enum": ["PASS", "VERIFIED"] } } },
              "T4": { "properties": { "status": { "enum": ["PASS", "VERIFIED"] } } },
              "T5": { "properties": { "status": { "enum": ["PASS", "VERIFIED"] } } },
              "T6": { "properties": { "status": { "enum": ["PASS", "VERIFIED"] } } },
              "T7": { "properties": { "status": { "enum": ["PASS", "VERIFIED"] } } }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "green_eligible": { "const": false } } },
      "then": { "properties": { "overall_status": { "not": { "const": "VERIFIED" } } } }
    }
  ]
}
